<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>MarkdownStudioPro.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <AssemblyName>Markdown Studio Pro</AssemblyName>
    <ApplicationIcon>Assets\markdown_studio_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinUI generates the Program/Main entry point from App.xaml.
         Keep stale Program.cs files out of compilation when this patch is applied over Stage 1. -->
    <Compile Remove="Program.cs" />
    <None Include="Program.cs" Condition="Exists('Program.cs')" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyWebView2LoaderToOutputRoot" AfterTargets="Build">
    <Copy
      SourceFiles="$(OutputPath)runtimes\win-x64\native\WebView2Loader.dll"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(OutputPath)runtimes\win-x64\native\WebView2Loader.dll')" />
  </Target>

  <Target Name="CopyWebView2LoaderToPublishRoot" AfterTargets="Publish">
    <Copy
      SourceFiles="$(PublishDir)runtimes\win-x64\native\WebView2Loader.dll"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(PublishDir)runtimes\win-x64\native\WebView2Loader.dll')" />
  </Target>
</Project>
